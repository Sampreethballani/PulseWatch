# ---------------------------------------------------------------------------
# PulseWatch environment template
#
# Copy these values into your shell, a Render service, or a local .env file
# loaded by your process manager. Never commit real secrets.
# ---------------------------------------------------------------------------

# Where monitoring history is stored. Development default: ./data/monitor.db
# Production (Render persistent disk): /var/data/monitor.db
DATABASE_PATH=./data/monitor.db

# Required in production: long random string used to sign the admin session.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-value

# Required to manage websites remotely. Leave empty locally to allow management
# only from this computer; visitors from the internet get a read-only dashboard.
ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Local server binding (Render supplies PORT automatically; HOST defaults to 0.0.0.0)
PORT=5000
HOST=0.0.0.0

# Optional production hardening
# TRUST_PROXY=1
# PULSEWATCH_PRODUCTION=1
# PULSEWATCH_SECURE_COOKIES=0   # only for plain-HTTP local smoke tests
# PULSEWATCH_REQUIRE_PERSISTENT_DB=1
# PULSEWATCH_PERSISTENT_DB_DIR=/var/data
# RATE_LIMIT_GENERAL_PER_MINUTE=240
# RATE_LIMIT_MUTATIONS_PER_MINUTE=30
# RATE_LIMIT_LOGIN_PER_MINUTE=10
# LOG_LEVEL=INFO

# Optional: disable the in-process monitoring worker (e.g. when running a
# separate worker process, or during tests)
# PULSEWATCH_DISABLE_SCHEDULER=1
